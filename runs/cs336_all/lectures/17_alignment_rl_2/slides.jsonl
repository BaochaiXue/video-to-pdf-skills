{"unit_id": "script_0064", "source_type": "official_executable_lecture_block", "source_id": "lecture_17.py", "loc": {"block": 64}, "text": "Batch size:", "asset_path": null, "required": true}
{"unit_id": "script_0065", "source_type": "official_executable_lecture_block", "source_id": "lecture_17.py", "loc": {"block": 65}, "text": "- Decouple batch size from loss", "asset_path": null, "required": true}
{"unit_id": "script_0066", "source_type": "official_executable_lecture_block", "source_id": "lecture_17.py", "loc": {"block": 66}, "text": "- Better than CLIP for <16K batch sizes", "asset_path": null, "required": true}
{"unit_id": "script_0067", "source_type": "official_executable_lecture_block", "source_id": "lecture_17.py", "loc": {"block": 67}, "text": "- Go up to 1M batch size, but 32K is enough", "asset_path": null, "required": true}
