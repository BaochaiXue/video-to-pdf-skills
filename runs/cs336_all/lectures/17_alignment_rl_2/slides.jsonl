{"unit_id": "script_0112", "source_type": "official_executable_lecture_block", "source_id": "lecture_17.py", "loc": {"block": 112}, "text": "- Stage 2: higher quality task-specific data, increase resolution; train all parameters", "asset_path": null, "required": true}
