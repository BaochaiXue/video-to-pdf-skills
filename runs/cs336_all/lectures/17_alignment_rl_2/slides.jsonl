{"unit_id": "trace_0105", "source_type": "official_trace_block", "source_id": "official_trace", "loc": {"trace_step": 1022, "rendering_index": 1, "path": "lecture_17.py", "line_number": 541, "function_name": "experiments"}, "text": "", "asset_path": "var/policy_gradient_rewards_naive.png", "required": false}
{"unit_id": "trace_0106", "source_type": "official_trace_block", "source_id": "official_trace", "loc": {"trace_step": 1023, "rendering_index": 1, "path": "lecture_17.py", "line_number": 542, "function_name": "experiments"}, "text": "Looking through the output, you'll see that by the end, we haven't really learned sorting very well (and this is still the training set).", "asset_path": null, "required": true}
{"unit_id": "trace_0107", "source_type": "official_trace_block", "source_id": "official_trace", "loc": {"trace_step": 1024, "rendering_index": 1, "path": "lecture_17.py", "line_number": 544, "function_name": "experiments"}, "text": "Let's try using centered rewards.", "asset_path": null, "required": true}
