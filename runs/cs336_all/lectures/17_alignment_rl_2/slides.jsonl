{"unit_id": "script_0123", "source_type": "official_executable_lecture_block", "source_id": "lecture_17.py", "loc": {"block": 123}, "text": "Many capabilities:", "asset_path": null, "required": true}
{"unit_id": "script_0124", "source_type": "official_executable_lecture_block", "source_id": "lecture_17.py", "loc": {"block": 124}, "text": "Language model:", "asset_path": null, "required": true}
{"unit_id": "script_0125", "source_type": "official_executable_lecture_block", "source_id": "lecture_17.py", "loc": {"block": 125}, "text": "- Qwen-3 models (dense and MoE models up to 235B-A22B)", "asset_path": null, "required": true}
{"unit_id": "script_0126", "source_type": "official_executable_lecture_block", "source_id": "lecture_17.py", "loc": {"block": 126}, "text": "- Long context understanding (256K)", "asset_path": null, "required": true}
{"unit_id": "script_0127", "source_type": "official_executable_lecture_block", "source_id": "lecture_17.py", "loc": {"block": 127}, "text": "Vision encoder:", "asset_path": null, "required": true}
{"unit_id": "script_0128", "source_type": "official_executable_lecture_block", "source_id": "lecture_17.py", "loc": {"block": 128}, "text": "- Interleaved MRoPE: distribute all axes (temporal, width, height) to low- and high-frequency bands", "asset_path": null, "required": true}
{"unit_id": "script_0129", "source_type": "official_executable_lecture_block", "source_id": "lecture_17.py", "loc": {"block": 129}, "text": "... [t w h t w h t w h t w h] rather than [t t t t w w w w h h h h]", "asset_path": null, "required": true}
{"unit_id": "script_0130", "source_type": "official_executable_lecture_block", "source_id": "lecture_17.py", "loc": {"block": 130}, "text": "- Add explicit video timestamps (as separate tokens rather in positional embeddings)", "asset_path": null, "required": true}
{"unit_id": "script_0131", "source_type": "official_executable_lecture_block", "source_id": "lecture_17.py", "loc": {"block": 131}, "text": "- Square-root-normalized per-token loss: balance text and multimodal data (video examples are long, don't want to dominate)", "asset_path": null, "required": true}
{"unit_id": "script_0132", "source_type": "official_executable_lecture_block", "source_id": "lecture_17.py", "loc": {"block": 132}, "text": "Adapter:", "asset_path": null, "required": true}
