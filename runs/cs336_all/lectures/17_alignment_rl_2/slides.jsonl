{"unit_id": "script_0114", "source_type": "official_executable_lecture_block", "source_id": "lecture_17.py", "loc": {"block": 114}, "text": "Visual encoder: larger ViT (675M)", "asset_path": null, "required": true}
{"unit_id": "script_0115", "source_type": "official_executable_lecture_block", "source_id": "lecture_17.py", "loc": {"block": 115}, "text": "- Key: dynamic resolution to handle varying resolutions", "asset_path": null, "required": true}
{"unit_id": "script_0116", "source_type": "official_executable_lecture_block", "source_id": "lecture_17.py", "loc": {"block": 116}, "text": "- Each 224 x 224 patch encoded with ViT/14, compress every 2x2 => 66 tokens", "asset_path": null, "required": true}
{"unit_id": "script_0117", "source_type": "official_executable_lecture_block", "source_id": "lecture_17.py", "loc": {"block": 117}, "text": "- Video: sample 2 frames/sec, max 16384 tokens", "asset_path": null, "required": true}
