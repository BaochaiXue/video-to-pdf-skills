{"unit_id": "script_0119", "source_type": "official_executable_lecture_block", "source_id": "lecture_17.py", "loc": {"block": 119}, "text": "Training (similar to Qwen-VL):", "asset_path": null, "required": true}
{"unit_id": "script_0120", "source_type": "official_executable_lecture_block", "source_id": "lecture_17.py", "loc": {"block": 120}, "text": "- Stage 1: train only visual encoder", "asset_path": null, "required": true}
