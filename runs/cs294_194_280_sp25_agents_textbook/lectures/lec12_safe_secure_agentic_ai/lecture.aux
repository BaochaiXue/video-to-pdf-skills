\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Agentic system 是 hybrid system：模型不再孤立运行，而是嵌在与工具、环境和外部世界的交互闭环中。}}{3}{figure.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.2}为什么 2025 年是 agents 的一年，同时也是 agentic risk 爆发的一年}{3}{subsection.2.2}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {3}攻击面与攻击链}{4}{section.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}LLM 输出如何进入攻击链}{4}{subsection.3.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces LLM 输出一旦成为 branch condition、tool argument 或 executable code，就从“内容风险”升级成“系统控制风险”。}}{4}{figure.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}从传统 SQL injection / RCE 到 agentic 漏洞}{5}{subsection.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces SQL injection 在 agentic system 中的危险，不只是用户输入本身恶意，还包括模型生成的 query 或 tool 参数被继续信任。}}{5}{figure.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Remote code execution 在 hybrid system 中的典型风险：模型输出被包装成命令或代码后继续执行。}}{5}{figure.5}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Prompt injection：直接注入、间接注入与 command-data mixing}{6}{subsection.3.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Direct prompt injection：恶意输入直接进入 prompt 空间并竞争 system instruction。}}{6}{figure.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Indirect prompt injection 的本质是把外部数据当成了命令空间的一部分。}}{6}{figure.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Prompt injection attack surface 不只来自当前用户输入，还包括 memory poisoning、knowledge base poisoning、external data poisoning 与 supply-chain attack。}}{7}{figure.8}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4}AgentPoison：为什么 memory poisoning 比单轮注入更持久}{7}{subsection.3.4}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4}评测与红队：为什么必须做系统级安全评估}{8}{section.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}LLM evaluation 与 agentic system evaluation 的区别}{8}{subsection.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces 评测对象从 model 行为变成 system 行为后，攻击面、责任边界和 failure mode 都变了。}}{8}{figure.9}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}AgentXploit：black-box 条件下的 end-to-end red teaming}{8}{subsection.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces AgentXploit 的动机：商业 agents 常常是 black-box，但这并不妨碍攻击者通过外部可控数据与反馈回路做红队搜索。}}{9}{figure.10}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}AgentXploit 的 fuzzing workflow}{9}{subsection.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces AgentXploit 的核心 workflow：seed -> mutation -> task execution -> feedback -> seed database update。}}{10}{figure.11}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces AgentXploit 的评测提醒我们：真正重要的是 attack success、transferability 与 component contribution，而不是某个单点 prompt 是否生效。}}{11}{figure.12}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {5}防御原则与机制}{11}{section.5}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}Defense-in-depth：为什么不能只靠一种防御}{11}{subsection.5.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces 三条总原则：分层防御、最小权限、以及设计阶段的安全性与可证明性。}}{11}{figure.13}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Lecture 给出的八层 defense mechanisms。关键点是：这些机制面向不同边界，彼此互补。}}{12}{figure.14}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Model hardening 与 input sanitization 的作用边界}{12}{subsection.5.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Least privilege on tool calls}{13}{subsection.5.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Least privilege 的真正落点是 tool call boundary，而不是 prompt 文本本身。}}{13}{figure.15}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {6}权限控制、系统边界与可证明安全}{13}{section.6}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {6.1}Progent：把 least privilege 变成可编程、可执行的 runtime gate}{13}{subsection.6.1}\protected@file@percent }
