\@writefile{toc}{\contentsline {section}{\numberline {1}问题背景：为什么机器人还没有实现真正自主学习}{2}{section.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces 标准强化学习默认存在环境重置接口；这一前提在真实机器人场景中往往不成立。}}{2}{figure.caption.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {1.1}自主 RL 的定义}{2}{subsection.1.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces 自主 RL 的核心要求：初始化一次，然后在尽量没有环境重置的前提下持续学习。}}{3}{figure.caption.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {1.2}评价指标也随之改变}{3}{subsection.1.2}\protected@file@percent }
