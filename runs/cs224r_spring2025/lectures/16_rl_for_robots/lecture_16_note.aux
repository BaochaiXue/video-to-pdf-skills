\@writefile{toc}{\contentsline {subsection}{\numberline {2.1}为什么简单地把 episode 拉长并不够}{4}{subsection.2.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces 非回合式训练的两个核心挑战：探索让轨迹漂移离开任务分布，状态分布坍塌让 agent 学不到好策略。}}{4}{figure.caption.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.2}为何 episodic RL 能工作，而 reset-free RL 更难}{4}{subsection.2.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.3}先学会回去，才有机会继续学会向前}{4}{subsection.2.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces 实验趋势说明：能够频繁回到初始分布时，forward task 能学会，因此关键难点转化为“如何学会恢复或重置”。}}{5}{figure.caption.5}\protected@file@percent }
