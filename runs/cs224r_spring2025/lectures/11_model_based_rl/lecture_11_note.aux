\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces 真实世界 ShadowHand 实验凸显了 model-based RL 的核心价值：在昂贵硬件上用更少真实交互获得可用策略。}}{10}{figure.caption.11}\protected@file@percent }
