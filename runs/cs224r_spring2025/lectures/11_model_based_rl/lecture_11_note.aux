\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}任务定义与为什么它是好案例}{8}{subsection.5.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces dexterous manipulation 被当作 case study 的原因：高维、真实交互昂贵，但又迫切需要高样本效率。}}{8}{figure.caption.9}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}为什么 ensemble 和改造版 CEM 有帮助}{9}{subsection.5.2}\protected@file@percent }
