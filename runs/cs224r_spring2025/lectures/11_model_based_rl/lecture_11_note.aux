\@writefile{toc}{\contentsline {section}{\numberline {2}第一条路：在模型里直接规划}{3}{section.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.1}把动作序列当作优化变量}{3}{subsection.2.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces 通过 learned model 直接对动作序列做规划：先学 $f_\phi (s,a)$，再在模型里搜索高回报动作。}}{3}{figure.caption.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.2}梯度法与采样法的差异}{4}{subsection.2.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces 梯度优化与采样优化的对比：前者依赖可微结构，后者更黑盒，但通常更稳健。}}{4}{figure.caption.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces CEM 式采样规划：采样候选动作序列、评估回报、保留 elite、再拟合采样分布。}}{4}{figure.caption.5}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.3}本章小结}{5}{subsection.2.3}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {3}为什么直接规划会失败，以及 MPC 如何补救}{5}{section.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}数据分布失配会让模型在关键区域失真}{5}{subsection.3.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces direct planning 的典型失败：模型只在旧策略数据分布上准确，到了新状态区域就会犯系统性错误。}}{5}{figure.caption.6}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}open-loop 为什么脆弱}{5}{subsection.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces MPC 的核心思想是 ``plan \& replan''：每次只执行第一个动作，再根据真实新状态重新规划。}}{6}{figure.caption.7}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}MPC：planning 也要闭环}{6}{subsection.3.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4}本章小结}{6}{subsection.3.4}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4}第二条路：不用模型直接决策，而是用模型扩充数据}{7}{section.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}为什么 imagined rollouts 更实用}{7}{subsection.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces model-based policy optimization 的全算法：真实环境数据训练模型，模型再从真实状态附近生成短 imagined rollouts。}}{7}{figure.caption.8}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}什么时候 model-based 值得做}{7}{subsection.4.2}\protected@file@percent }
