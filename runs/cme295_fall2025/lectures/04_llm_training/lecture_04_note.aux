\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}LoRA 应该加在哪里，以及它的训练动态有什么特殊性}{8}{subsection.5.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}QLoRA：把冻结权重量化，再保留全精度 LoRA 分支}{9}{subsection.5.4}\protected@file@percent }
